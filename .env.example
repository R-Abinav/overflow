# ── LLM (required) ─────────────────────────────────────────────────────────
# Claude is primary as of Phase 5 — set this. Gemini is only a legacy dev-time
# fallback (used before the Phase 5 swap); llm.ts checks ANTHROPIC_API_KEY
# first, so leaving GEMINI_API_KEY unset is fine and recommended.
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=

# ── Role & resource thresholds ────────────────────────────────────────────
# ROLE is the default when --role= isn't passed on the CLI (`overflow` alone
# defaults to provider either way). FREE_RAM_THRESHOLD_MB / _CPU_ decide
# whether a requester is "constrained" (delegates) or not (runs locally).
# Set FREE_RAM_THRESHOLD_MB=999999 to reliably force the constrained path on
# any machine for testing/demo purposes.
ROLE=provider
FREE_RAM_THRESHOLD_MB=512
FREE_CPU_THRESHOLD_PERCENT=85

# FORCE_CONSTRAINED=true|false overrides the real RAM/CPU check entirely —
# used by the multi-agent Docker Compose topology (one value per requester
# container) for a deterministic demo instead of depending on host load.
# Leave unset for real threshold-based detection.
# FORCE_CONSTRAINED=

# ── AXL mesh identity ──────────────────────────────────────────────────────
# Do NOT set AXL_CONFIG_PATH here for normal local (non-Docker) use — index.ts
# already picks node-config-a.json (provider) or node-config-b.json (requester)
# automatically based on --role. Only set this explicitly when running more
# than one identity on one machine (e.g. the 3-requester Compose topology,
# where each container's environment sets it to -b/-c/-d.json individually).
# AXL_CONFIG_PATH=

# AXL_API_PORT and DAEMON_PORT below are NOT currently wired to anything —
# index.ts hardcodes ports by role (provider: 3001/9002, requester: 3002/9012)
# regardless of these values. Left here only as a heads-up; setting them has
# no effect today.
# AXL_API_PORT=9002
# DAEMON_PORT=3001

# ── Sandbox ────────────────────────────────────────────────────────────────
SANDBOX_MAX_ATTEMPTS=3
SANDBOX_TIMEOUT_MS=20000

# ── examples/rca-agent.ts (only needed to run the RCA reference client) ────
# A PAT with repo scope on the demo repo you want rca-agent.ts to open real
# PRs against, and that repo in owner/repo form.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# ── Ollama (unused — informational only) ────────────────────────────────────
# resources.ts checks whether Ollama is reachable for its own status
# reporting, but nothing in the live pipeline calls it — executor.ts's local
# inference path is a mocked stub that was never wired to a real model, and
# the unconstrained-requester path runs generated code directly via the same
# sandbox executor the provider uses, not Ollama. Safe to leave Ollama
# uninstalled entirely.
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=tinyllama

# ── P1 — escrow / ENS / KeeperHub (not required for P0, unused in the live
# message flow; see SUPPORT.md). Leave blank unless you're working on P1. ──
WALLET_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=
DEPLOYER_WALLET_ADDRESS=
REQUESTER_WALLET_ADDRESS=
PROVIDER_WALLET_ADDRESS=
ESCROW_CONTRACT_ADDR=
USDC_CONTRACT_ADDRESS=
KEEPERHUB_WEBHOOK_URL=
KEEPERHUB_TOKEN=
ENS_NAME=my-node.overflow.eth
ENS_RPC_URL=https://ethereum-rpc.publicnode.com
PRICE_PER_JOB_USDC=0.01
CHAIN=base-sepolia
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
